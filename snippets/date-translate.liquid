{%- comment -%}
  Translate availability dates using the storefront locale.
  dateString is an existing English date/month string; preserve other content.
{%- endcomment -%}
{%- liquid
  assign date_locale = request.locale.iso_code | downcase | split: '-' | first
  assign months_en = 'January,February,March,April,May,June,July,August,September,October,November,December' | split: ','
  assign days_en = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ','
  assign months_local = ''
  assign days_local = ''
  case date_locale
    when 'pl'
      assign months_local = 'styczniu,lutym,marcu,kwietniu,maju,czerwcu,lipcu,sierpniu,wrześniu,październiku,listopadzie,grudniu'
      assign days_local = 'poniedziałek,wtorek,środa,czwartek,piątek,sobota,niedziela'
    when 'sv'
      assign months_local = 'januari,februari,mars,april,maj,juni,juli,augusti,september,oktober,november,december'
      assign days_local = 'måndag,tisdag,onsdag,torsdag,fredag,lördag,söndag'
    when 'de'
      assign months_local = 'Januar,Februar,März,April,Mai,Juni,Juli,August,September,Oktober,November,Dezember'
      assign days_local = 'Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag,Sonntag'
    when 'fr'
      assign months_local = 'janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre'
      assign days_local = 'lundi,mardi,mercredi,jeudi,vendredi,samedi,dimanche'
    when 'nl'
      assign months_local = 'januari,februari,maart,april,mei,juni,juli,augustus,september,oktober,november,december'
      assign days_local = 'maandag,dinsdag,woensdag,donderdag,vrijdag,zaterdag,zondag'
    when 'es'
      assign months_local = 'enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre'
      assign days_local = 'lunes,martes,miércoles,jueves,viernes,sábado,domingo'
    when 'cs'
      assign months_local = 'lednu,únoru,březnu,dubnu,květnu,červnu,červenci,srpnu,září,říjnu,listopadu,prosinci'
      assign days_local = 'pondělí,úterý,středa,čtvrtek,pátek,sobota,neděle'
    when 'no', 'nb'
      assign months_local = 'januar,februar,mars,april,mai,juni,juli,august,september,oktober,november,desember'
      assign days_local = 'mandag,tirsdag,onsdag,torsdag,fredag,lørdag,søndag'
  endcase
  assign translated_date = dateString
  if months_local != blank
    assign months_local = months_local | split: ','
    assign days_local = days_local | split: ','
    for month in months_en
      assign translated_month = months_local[forloop.index0]
      assign translated_date = translated_date | replace: month, translated_month
    endfor
    for day in days_en
      assign translated_day = days_local[forloop.index0]
      assign translated_date = translated_date | replace: day, translated_day
    endfor
  endif
-%}
{{- translated_date -}}
